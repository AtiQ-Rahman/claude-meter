{
  "manifest_version": 3,
  "name": "Claude Meter",
  "version": "0.1.0",
  "description": "Live claude.ai session and weekly usage limits, with sound alerts and a pace forecast. No servers, no tracking.",
  "homepage_url": "https://github.com/AtiQ-Rahman/claude-meter",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Claude Meter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
