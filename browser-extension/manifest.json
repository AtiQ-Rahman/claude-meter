{
  "manifest_version": 3,
  "name": "Usage Meter for Claude",
  "short_name": "Usage Meter",
  "version": "0.1.0",
  "description": "Your real claude.ai session and weekly limits, with sound alerts, a pace forecast and messages-left estimate. Unofficial; no servers, no tracking.",
  "homepage_url": "https://github.com/AtiQ-Rahman/claude-meter",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Usage Meter for Claude",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
